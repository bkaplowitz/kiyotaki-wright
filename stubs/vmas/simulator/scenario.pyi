from abc import ABC, abstractmethod
from typing import Any

import torch

from vmas.simulator.core import Agent, World
from vmas.simulator.rendering import Geom
from vmas.simulator.utils import AGENT_INFO_TYPE, AGENT_OBS_TYPE, AGENT_REWARD_TYPE

class BaseScenario(ABC):
    _world: World | None
    viewer_size: int
    viewer_zoom: float
    render_origin: tuple[float, float]
    plot_grid: bool
    grid_spacing: float
    visualize_semidims: bool

    @property
    def world(self) -> World: ...
    def to(self, device: torch.device) -> None: ...
    def env_make_world(
        self, batch_dim: int, device: torch.device, **kwargs: Any
    ) -> World: ...
    @abstractmethod
    def make_world(
        self, batch_dim: int, device: torch.device, **kwargs: Any
    ) -> World: ...
    @abstractmethod
    def reset_world_at(self, env_index: int | None = None) -> None: ...
    @abstractmethod
    def observation(self, agent: Agent) -> AGENT_OBS_TYPE: ...
    @abstractmethod
    def reward(self, agent: Agent) -> AGENT_REWARD_TYPE: ...
    def done(self) -> torch.Tensor: ...
    def info(self, agent: Agent) -> AGENT_INFO_TYPE: ...
    def extra_render(self, env_index: int = 0) -> list[Geom]: ...
    def process_action(self, agent: Agent) -> None: ...
    def pre_step(self) -> None: ...
    def post_step(self) -> None: ...
